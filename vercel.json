{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/devices/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/devices/models/(.*)",
      "destination": "/models/$1"
    },
    {
      "source": "/devices/draco/(.*)",
      "destination": "/draco/$1"
    },
    {
      "source": "/devices/textures/(.*)",
      "destination": "/textures/$1"
    },
    {
      "source": "/devices/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/devices/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/devices",
      "destination": "/index.html"
    },
    {
      "source": "/worlds",
      "destination": "/index.html"
    },
    {
      "source": "/game",
      "destination": "/index.html"
    },
    {
      "source": "/mission",
      "destination": "/index.html"
    },
    {
      "source": "/solvix",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/draco/(.*\\.wasm)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/draco/(.*\\.js)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/textures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
